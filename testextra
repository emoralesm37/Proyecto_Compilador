# 1 Clase visitor para evaluar la operacion

class EvaluarVisitor(ExpresionesVisitor):
    def visitSuma(self, ctx):
        return self.visit(ctx.expr(0)) + self.visit(ctx.expr(1))

    def visitResta(self, ctx):
        return self.visit(ctx.expr(0)) - self.visit(ctx.expr(1))

    def visitMultiplicacion(self, ctx):
        return self.visit(ctx.expr(0)) * self.visit(ctx.expr(1))

    def visitDivision(self, ctx):
        return self.visit(ctx.expr(0)) / self.visit(ctx.expr(1))

    def visitNumero(self, ctx):
        return int(ctx.NUMERO().getText())
    def visitParentesis(self, ctx):
        return self.visit(ctx.expr())
    
    def visitLiteral(self, ctx):
        return int(ctx.NUMERO().getText())
    
    # 2 Funcion para imprimir el arbol de forma visual
    def print_tree(node, indent="", us_last=True, parser=None):
        marker = "└─ " if us_last else "├─ "
        #Obtener el nombre de la regla o el texto del token
        Name =Trees.getNodeText(node, parser.Names if parser else None);
        print(f"{indent}{marker}{Name}")

