// ============================================================
// Caso de prueba 1: Programa válido complejo
// Incluye: arreglos, while con break, for, funciones, módulo %
// ============================================================

program DemoCompleto {

    // ── Arreglo y ciclo con break ──
    int[] nums = [3, 1, 4, 1, 5];
    int total = 0;
    int i = 0;

    while (i < 5) {
        int r = nums[i] % 2;
        if (r == 0) {
            total = total + nums[i];
        }
        i = i + 1;
        if (total > 10) { break; }
    }

    // ── For clásico ──
    int suma = 0;
    for (int j = 1; j <= 10; j = j + 1) {
        suma = suma + j;
    }

    // ── Función recursiva ──
    int fibonacci(int n) {
        if (n <= 1) { return n; }
        return fibonacci(n - 1) + fibonacci(n - 2);
    }

    // ── Concatenación de strings ──
    string msg = "Fibonacci(10) = ";
    print(msg);
    print(fibonacci(10));

    print("Suma 1..10:");
    print(suma);

    print("Total pares del arreglo:");
    print(total);
}
